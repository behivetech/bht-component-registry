{
  "name": "@{{ scope }}/{{ category }}.{{ dashCase name }}",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "index.ts",
    "{{ dashCase name }}.tsx",
    "{{ dashCase name }}.module.scss",
    "*.composition.tsx",
    "docs.json"
  ],
  "registry": {
    "status": "draft",
    "tags": []
  },
  "scripts": {
    "build": "tsup && bht-registry-docgen",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@bht-component-registry/class-names": "workspace:*",
    "@bht-component-registry/env": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "{{ repositoryUrl }}",
    "directory": "registry/{{ scope }}/{{ category }}/{{ dashCase name }}"
  },
  "publishConfig": {
    "registry": "{{ npmRegistry }}",
    "access": "public"
  }
}
