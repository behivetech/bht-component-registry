    "next": "16.3.7",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-live": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@bht-component-registry/env": "workspace:*",
    "@bht-component-registry/typescript-config": "workspace:*",
