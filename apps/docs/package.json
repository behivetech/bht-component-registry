{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://platform.behivetech.com",
  "scripts": {
    "generate": "tsx scripts/generate-catalog.ts",
    "predev": "pnpm generate",
    "dev": "next dev --port 3000",
