{
  "name": "bht-component-registry",
  "private": true,
  "description": "A bit.dev-style component registry that stays in git: docs generated from source, live examples, versions via Changesets. Static site, deploy anywhere.",
  "homepage": "https://platform.behivetech.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/behivetech/bht-component-registry.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter \"docs^...\" run build && pnpm --filter docs run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "check-types": "pnpm -r run check-types",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter docs test:e2e",
    "verify": "pnpm build && pnpm lint && pnpm check-types && pnpm test",
    "gen": "tsx scripts/gen.mts",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-template-version.mjs",
    "release": "pnpm --filter \"{./registry/**}...\" --filter create-bht-component-registry run build && changeset publish",
    "serve": "pnpm --filter docs serve"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/prompts": "^2.4.9",
    "esbuild-sass-plugin": "catalog:",
    "handlebars": "^4.7.9",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "postcss-modules": "catalog:",
    "prettier": "^3.9.6",
    "prompts": "^2.4.2",
    "sass": "^1.105.0",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  }
}
