{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../registry.config.json"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "docs.json"]
    },
    // The docs site reads the whole registry and the repo config; an optional
    // read token lets the Changelog tab list what is actually published.
    "docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../registry.config.json", "../../registry/**"],
      "env": ["REGISTRY_READ_TOKEN"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // No `dependsOn` on purpose: linting needs nothing built, and `^lint`
    // would serialize the whole graph.
    "lint": {},
    // These genuinely need upstream `dist/` to resolve workspace imports.
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.spec.*", "**/*.test.*"]
    }
  }
}
