# TEMPORARY, until the @behivetech packages are published to the public npm
# registry again. The shared class-name helper (@behivetech/bht-class-names)
# and the docs site's chrome (Button, Card, Badge, Table, TextField,
# EmptyState, HeroBanner, the token sheet) install from GitHub Packages, which
# needs a token with read:packages even for public packages.
#
# The token is never written in the repo. pnpm 11 ignores a credential that
# expands an environment variable when it sits in a project .npmrc (the file is
# committed), so the token line goes in your user-level ~/.npmrc, which reads
# the variable:
#
#   echo '//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}' >> ~/.npmrc
#   export NODE_AUTH_TOKEN=<a GitHub token with read:packages>
#
# CI does the same through actions/setup-node and the secret PACKAGES_READ_TOKEN.
# Delete the line below to go back to the public registry; nothing else changes.
@behivetech:registry=https://npm.pkg.github.com
