{
  "name": "create-bht-component-registry",
  "version": "0.2.0",
  "description": "Scaffold a bht-component-registry — a bit.dev-style component registry that stays in git — and keep it up to date with `update`.",
  "keywords": [
    "component-registry",
    "design-system",
    "create",
    "scaffold",
    "nextjs",
    "pnpm-workspace",
    "changesets"
  ],
  "homepage": "https://platform.behivetech.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/behivetech/bht-component-registry.git",
    "directory": "packages/create-bht-component-registry"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-bht-component-registry": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@bht-component-registry/eslint-config": "workspace:*",
    "@bht-component-registry/scope": "workspace:*",
    "@bht-component-registry/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/prompts": "^2.4.9",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
