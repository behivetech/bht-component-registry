{
  "$schema": "./template.manifest.schema.json",
  "owned": [
    "apps/docs/**",
    ".npmrc",
    "packages/**",
    "scripts/**",
    "plopfile.ts",
    "vitest.config.ts",
    "turbo/generators/**",
    ".github/workflows/**",
    ".github/copilot-instructions.md",
    ".changeset/config.json",
    "turbo.json",
    "pnpm-workspace.yaml",
    "package.json",
    "registry.config.schema.json",
    "template.manifest.json",
    "template.manifest.schema.json",
    ".gitignore",
    "Dockerfile",
    "nginx.conf",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "TERMS.md"
  ],
  "never": [
    "registry/**",
    "generators/**",
    "docs/**",
    "registry.config.json",
    ".changeset/*.md",
    "apps/docs/src/generated/**"
  ],
  "templateOnly": [
    "packages/create-bht-component-registry/**"
  ],
  "readmeMarker": "<!-- your notes below this line are kept by update -->",
  "rewriteScope": [
    "apps/docs/e2e/public.spec.ts",
    "apps/docs/package.json",
    "docs/using-this-registry.md"
  ]
}
